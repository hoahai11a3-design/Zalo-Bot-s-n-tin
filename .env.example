# ===== Zalo Bot (bắt buộc) =====
# Tạo bot theo hướng dẫn tại https://bot.zaloplatforms.com/docs để lấy token
ZALO_BOT_TOKEN=
ZALO_MODE=polling            # polling (dễ nhất) | webhook (cần domain HTTPS)
WEBHOOK_URL=                 # vd https://bot.example.com  (chỉ dùng khi ZALO_MODE=webhook)
WEBHOOK_SECRET=doi-chuoi-bi-mat-nay
PORT=8080

# Tên để gọi bot khi tag trong nhóm, tên đầu tiên hiển thị ở cuối bản tin
BOT_NAMES=Hóng,Hong,bot
# ID người được bật/tắt/đổi tần suất (để trống = ai cũng được). Gõ /id trong chat để xem ID
ADMIN_IDS=
# Chat/nhóm tự động nhận tin ngay khi bot chạy (hoặc gõ /dangky trong nhóm)
BROADCAST_CHAT_IDS=

# ===== Lịch gửi & giọng văn =====
POST_INTERVAL_MINUTES=15
MAX_ITEMS_PER_POST=5
QUIET_HOURS=0-6              # không tự gửi từ 0h đến 6h
TIMEZONE=Asia/Ho_Chi_Minh
PERSONA=hong                 # hong (Gen Z hóng biến) | nghiem (nghiêm túc) | hai (tấu hài)
DEDUP_DAYS=3                 # không gửi lại tin giống nhau trong 3 ngày

# ===== Model AI miễn phí (điền ít nhất 1, bot thử lần lượt) =====
# Groq: https://console.groq.com/keys  (nhanh, free)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini: https://aistudio.google.com/apikey  (free tier, tiếng Việt tốt)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter: https://openrouter.ai/keys  (các model đuôi :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Chạy model trên máy mình bằng Ollama (không cần key)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# ===== Nguồn tin =====
THREADS_KEYWORDS=drama,biến căng,sale,giảm giá
THREADS_ACCOUNTS=            # vd: theanh28,beatvn.network (theo dõi các trang hay đăng biến)
THREADS_ACCESS_TOKEN=        # (tuỳ chọn) token API chính thức của Meta, nếu có
THREADS_STATE_FILE=data/threads_state.json
# RSS_FEEDS=https://vnexpress.net/rss/tin-xem-nhieu.rss,https://kenh14.vn/rss/home.rss
# SALE_QUERIES=flash sale,mã giảm giá,khuyến mãi khủng
SOURCE_CACHE_MINUTES=10
